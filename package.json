{
  "name": "vscode-sailpoint-identityiq",
  "displayName": "SailPoint IdentityIQ",
  "description": "Manage SailPoint IdentityIQ objects (Rules, Workflows, Tasks, Applications...) directly from VS Code",
  "version": "0.0.1",
  "publisher": "yannick-beot-sp",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sailpoint",
    "identityiq",
    "iiq",
    "iam",
    "identity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yannick-beot-sp/vscode-sailpoint-identityiq"
  },
  "activationEvents": [
    "onFileSystem:iiq",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.beanshell.injection",
        "path": "./syntaxes/beanshell-injection.tmLanguage.json",
        "injectTo": ["text.xml"],
        "embeddedLanguages": {
          "meta.embedded.block.java": "java"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iiq-explorer",
          "title": "IdentityIQ",
          "icon": "resources/iiq.svg"
        }
      ]
    },
    "views": {
      "iiq-explorer": [
        {
          "id": "iiq.view.environments",
          "name": "Environments",
          "icon": "resources/iiq.svg",
          "contextualTitle": "IdentityIQ Environments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "iiq.view.environments",
        "contents": "No IdentityIQ environment yet.\n[Add environment](command:iiq.tenant.add)"
      }
    ],
    "commands": [
      {
        "command": "iiq.tenant.add",
        "title": "Add environment...",
        "category": "IIQ",
        "icon": "$(add)"
      },
      {
        "command": "iiq.tenant.remove",
        "title": "Remove environment...",
        "category": "IIQ"
      },
      {
        "command": "iiq.tenant.rename",
        "title": "Rename environment...",
        "category": "IIQ"
      },
      {
        "command": "iiq.tenant.test-connection",
        "title": "Test connection",
        "category": "IIQ"
      },
      {
        "command": "iiq.tenant.set-active",
        "title": "Set as active environment",
        "category": "IIQ"
      },
      {
        "command": "iiq.select-environment",
        "title": "Select environment...",
        "category": "IIQ"
      },
      {
        "command": "iiq.folder.add",
        "title": "New folder...",
        "category": "IIQ",
        "icon": "$(new-folder)"
      },
      {
        "command": "iiq.folder.rename",
        "title": "Rename folder...",
        "category": "IIQ"
      },
      {
        "command": "iiq.folder.remove",
        "title": "Remove folder...",
        "category": "IIQ"
      },
      {
        "command": "iiq.open-object",
        "title": "Open object...",
        "category": "IIQ"
      },
      {
        "command": "iiq.export-objects",
        "title": "Export objects...",
        "category": "IIQ"
      },
      {
        "command": "iiq.import-file",
        "title": "Import file...",
        "category": "IIQ"
      },
      {
        "command": "iiq.import-file-view",
        "title": "Import file...",
        "category": "IIQ"
      },
      {
        "command": "iiq.import-file-explorer",
        "title": "IIQ: Import file(s)...",
        "category": "IIQ"
      },
      {
        "command": "iiq.refresh-file",
        "title": "Refresh file from IdentityIQ...",
        "category": "IIQ"
      },
      {
        "command": "iiq.compare-file",
        "title": "Compare with IdentityIQ...",
        "category": "IIQ"
      },
      {
        "command": "iiq.rule.add",
        "title": "New rule...",
        "category": "IIQ",
        "icon": "$(add)"
      },
      {
        "command": "iiq.run-rule",
        "title": "Run rule...",
        "category": "IIQ",
        "icon": "$(play)"
      },
      {
        "command": "iiq.run-task",
        "title": "Run task...",
        "category": "IIQ",
        "icon": "$(play)"
      },
      {
        "command": "iiq.application.test-connection",
        "title": "Test connection...",
        "category": "IIQ",
        "icon": "$(plug)"
      },
      {
        "command": "iiq.application.peek-objects",
        "title": "Peek objects...",
        "category": "IIQ",
        "icon": "$(eye)"
      },
      {
        "command": "iiq.preview-workflow",
        "title": "Preview workflow",
        "category": "IIQ",
        "icon": "$(open-preview)"
      },
      {
        "command": "iiq.tail-logs",
        "title": "Tail server logs...",
        "category": "IIQ",
        "icon": "$(output)"
      },
      {
        "command": "iiq.stop-tail-logs",
        "title": "Stop tailing server logs...",
        "category": "IIQ"
      },
      {
        "command": "iiq.configure-logging",
        "title": "Configure logging...",
        "category": "IIQ",
        "icon": "$(gear)"
      },
      {
        "command": "iiq.object.save",
        "title": "Save to file...",
        "category": "IIQ"
      },
      {
        "command": "iiq.object.clone",
        "title": "Clone object...",
        "category": "IIQ"
      },
      {
        "command": "iiq.object.copy-to-tenant",
        "title": "Copy object to environment...",
        "category": "IIQ"
      },
      {
        "command": "iiq.object.copy-to-tenant-view",
        "title": "Copy object to environment...",
        "category": "IIQ"
      },
      {
        "command": "iiq.object.delete",
        "title": "Delete object...",
        "category": "IIQ"
      },
      {
        "command": "iiq.refresh",
        "title": "Refresh",
        "category": "IIQ",
        "icon": "$(refresh)"
      },
      {
        "command": "iiq.refresh-node",
        "title": "Refresh",
        "category": "IIQ",
        "icon": "$(refresh)"
      },
      {
        "command": "iiq.load-more",
        "title": "Load more...",
        "category": "IIQ"
      },
      {
        "command": "iiq.sort-by-name",
        "title": "Sort by name",
        "category": "IIQ",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "iiq.sort-by-last-modified",
        "title": "Sort by last modification date",
        "category": "IIQ",
        "icon": "$(history)"
      },
      {
        "command": "iiq.filter-objects",
        "title": "Filter by name...",
        "category": "IIQ",
        "icon": "$(search)"
      },
      {
        "command": "iiq.clear-filter",
        "title": "Clear filter",
        "category": "IIQ",
        "icon": "$(search-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "iiq.tenant.remove",
          "when": "false"
        },
        {
          "command": "iiq.tenant.rename",
          "when": "false"
        },
        {
          "command": "iiq.tenant.set-active",
          "when": "false"
        },
        {
          "command": "iiq.folder.add",
          "when": "false"
        },
        {
          "command": "iiq.folder.rename",
          "when": "false"
        },
        {
          "command": "iiq.folder.remove",
          "when": "false"
        },
        {
          "command": "iiq.object.save",
          "when": "false"
        },
        {
          "command": "iiq.object.delete",
          "when": "false"
        },
        {
          "command": "iiq.object.copy-to-tenant-view",
          "when": "false"
        },
        {
          "command": "iiq.refresh-node",
          "when": "false"
        },
        {
          "command": "iiq.load-more",
          "when": "false"
        },
        {
          "command": "iiq.sort-by-name",
          "when": "false"
        },
        {
          "command": "iiq.sort-by-last-modified",
          "when": "false"
        },
        {
          "command": "iiq.filter-objects",
          "when": "false"
        },
        {
          "command": "iiq.clear-filter",
          "when": "false"
        },
        {
          "command": "iiq.import-file-view",
          "when": "false"
        },
        {
          "command": "iiq.import-file-explorer",
          "when": "false"
        },
        {
          "command": "iiq.refresh-file",
          "when": "editorLangId == xml"
        },
        {
          "command": "iiq.compare-file",
          "when": "editorLangId == xml"
        },
        {
          "command": "iiq.preview-workflow",
          "when": "iiq.isWorkflow"
        }
      ],
      "editor/title": [
        {
          "command": "iiq.preview-workflow",
          "when": "resourceLangId == xml && iiq.isWorkflow",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "iiq.tenant.add",
          "when": "view == iiq.view.environments",
          "group": "navigation@1"
        },
        {
          "command": "iiq.folder.add",
          "when": "view == iiq.view.environments",
          "group": "navigation@2"
        },
        {
          "command": "iiq.refresh",
          "when": "view == iiq.view.environments",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "iiq.tenant.set-active",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "1_environment@1"
        },
        {
          "command": "iiq.select-environment",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "1_environment@2"
        },
        {
          "command": "iiq.tenant.test-connection",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@1"
        },
        {
          "command": "iiq.open-object",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@2"
        },
        {
          "command": "iiq.export-objects",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@3"
        },
        {
          "command": "iiq.import-file-view",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@5"
        },
        {
          "command": "iiq.tail-logs",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@6"
        },
        {
          "command": "iiq.configure-logging",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "2_actions@7"
        },
        {
          "command": "iiq.tenant.rename",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "3_edit@1"
        },
        {
          "command": "iiq.tenant.remove",
          "when": "view == iiq.view.environments && viewItem == iiqTenant",
          "group": "3_edit@2"
        },
        {
          "command": "iiq.tenant.add",
          "when": "view == iiq.view.environments && viewItem == iiqFolder",
          "group": "1_folder@0"
        },
        {
          "command": "iiq.folder.add",
          "when": "view == iiq.view.environments && viewItem == iiqFolder",
          "group": "1_folder@1"
        },
        {
          "command": "iiq.folder.rename",
          "when": "view == iiq.view.environments && viewItem == iiqFolder",
          "group": "1_folder@2"
        },
        {
          "command": "iiq.folder.remove",
          "when": "view == iiq.view.environments && viewItem == iiqFolder",
          "group": "1_folder@3"
        },
        {
          "command": "iiq.refresh-node",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType/",
          "group": "1_objecttype@1"
        },
        {
          "command": "iiq.sort-by-name",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-sorted-by-lastModified(-filtered)?$/",
          "group": "1_objecttype@2"
        },
        {
          "command": "iiq.sort-by-last-modified",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-sorted-by-name(-filtered)?$/",
          "group": "1_objecttype@2"
        },
        {
          "command": "iiq.filter-objects",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-/ && !(viewItem =~ /-filtered$/)",
          "group": "1_objecttype@3"
        },
        {
          "command": "iiq.clear-filter",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-filtered$/",
          "group": "1_objecttype@3"
        },
        {
          "command": "iiq.export-objects",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-/",
          "group": "1_objecttype@4"
        },
        {
          "command": "iiq.sort-by-name",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-sorted-by-lastModified(-filtered)?$/",
          "group": "inline@1"
        },
        {
          "command": "iiq.sort-by-last-modified",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-sorted-by-name(-filtered)?$/",
          "group": "inline@1"
        },
        {
          "command": "iiq.filter-objects",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-/ && !(viewItem =~ /-filtered$/)",
          "group": "inline@2"
        },
        {
          "command": "iiq.clear-filter",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-.*-filtered$/",
          "group": "inline@2"
        },
        {
          "command": "iiq.refresh-node",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType/",
          "group": "inline@3"
        },
        {
          "command": "iiq.rule.add",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObjectType-Rule-/",
          "group": "inline@1"
        },
        {
          "command": "iiq.run-rule",
          "when": "view == iiq.view.environments && viewItem == iiqObject-Rule",
          "group": "inline"
        },
        {
          "command": "iiq.run-rule",
          "when": "view == iiq.view.environments && viewItem == iiqObject-Rule",
          "group": "0_run@1"
        },
        {
          "command": "iiq.run-task",
          "when": "view == iiq.view.environments && viewItem == iiqObject-TaskDefinition",
          "group": "inline"
        },
        {
          "command": "iiq.run-task",
          "when": "view == iiq.view.environments && viewItem == iiqObject-TaskDefinition",
          "group": "0_run@1"
        },
        {
          "command": "iiq.application.test-connection",
          "when": "view == iiq.view.environments && viewItem == iiqObject-Application",
          "group": "0_run@1"
        },
        {
          "command": "iiq.application.peek-objects",
          "when": "view == iiq.view.environments && viewItem == iiqObject-Application",
          "group": "0_run@2"
        },
        {
          "command": "iiq.object.save",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObject-/",
          "group": "1_object@1"
        },
        {
          "command": "iiq.object.clone",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObject-/",
          "group": "1_object@3"
        },
        {
          "command": "iiq.object.copy-to-tenant-view",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObject-/",
          "group": "1_object@2"
        },
        {
          "command": "iiq.object.delete",
          "when": "view == iiq.view.environments && viewItem =~ /^iiqObject-/",
          "group": "1_object@4"
        }
      ],
      "editor/context": [
        {
          "command": "iiq.import-file",
          "when": "resourceLangId == xml && resourceScheme == file",
          "group": "iiq@1"
        },
        {
          "command": "iiq.refresh-file",
          "when": "resourceLangId == xml && resourceScheme == file",
          "group": "iiq@2"
        },
        {
          "command": "iiq.compare-file",
          "when": "resourceLangId == xml",
          "group": "iiq@3"
        },
        {
          "command": "iiq.run-rule",
          "when": "resourceLangId == xml",
          "group": "iiq@4"
        },
        {
          "command": "iiq.preview-workflow",
          "when": "resourceLangId == xml && iiq.isWorkflow",
          "group": "iiq@5"
        }
      ],
      "explorer/context": [
        {
          "command": "iiq.import-file-explorer",
          "when": "resourceLangId == xml || explorerResourceIsFolder",
          "group": "iiq@1"
        }
      ]
    },
    "configuration": {
      "title": "SailPoint IdentityIQ",
      "properties": {
        "iiq.pagination.pageSize": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "Number of objects retrieved per page when listing objects."
        },
        "iiq.objectList.sort": {
          "type": "string",
          "enum": [
            "name",
            "lastModified"
          ],
          "default": "name",
          "description": "Default sort order when listing objects."
        },
        "iiq.connection.rejectUnauthorized": {
          "type": "boolean",
          "default": true,
          "description": "Verify SSL certificates when connecting to IdentityIQ. Disable for environments with self-signed certificates."
        },
        "iiq.logs.pollIntervalMs": {
          "type": "integer",
          "default": 2000,
          "minimum": 500,
          "maximum": 60000,
          "description": "Interval in milliseconds between two polls while tailing server logs."
        },
        "iiq.export.removeIds": {
          "type": "boolean",
          "default": true,
          "description": "Remove internal object ids (id attribute) when exporting XML."
        },
        "iiq.export.removeCreatedTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "Remove the created timestamp attribute when exporting XML."
        },
        "iiq.export.removeModifiedTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "Remove the modified timestamp attribute when exporting XML."
        },
        "iiq.export.removeReferenceIds": {
          "type": "boolean",
          "default": true,
          "description": "Remove id attributes from <Reference> elements when exporting XML. References are resolved by name at import time."
        },
        "iiq.export.removeSignificantModified": {
          "type": "boolean",
          "default": true,
          "description": "Remove the significantModified attribute when exporting XML."
        },
        "iiq.export.cleanForSourceControl": {
          "type": "boolean",
          "default": true,
          "description": "Additional cleaning for source control: remove volatile attributes (lastRefresh, dirty...), normalize line endings and trailing whitespace."
        },
        "iiq.beanshell.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable BeanShell language assistance (completion, hover, signature help) inside <Source> sections of IdentityIQ XML."
        },
        "iiq.beanshell.classpath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Jar files or folders containing jars used for Java completion, typically the WEB-INF/lib folder of an IdentityIQ installation."
        },
        "iiq.beanshell.maxCompletionItems": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of class-name completion items returned at once."
        },
        "iiq.xml.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DTD-driven XML completion (elements, attributes, enumerated attribute values) for IdentityIQ XML documents."
        },
        "iiq.xml.dtdPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a custom sailpoint.dtd file used for XML completion, overriding the bundled DTD (e.g. for a different IdentityIQ version or a plugin-extended schema). Leave empty to use the bundled DTD."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "test": "vscode-test",
    "generate-jdk-index": "java scripts/GenerateJdkIndex.java > resources/jdk-core-index.json",
    "build-test-fixtures": "cd src/test/fixtures && rm -rf classes && mkdir classes && javac -g --release 11 -d classes java-src/com/example/fixture/*.java && jar cf fixture.jar -C classes . && rm -rf classes"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "axios": "^1.13.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
